<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Bank of Vikhroli</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="topbar">
        <a class="brand" asp-page="/Index">BANK OF VIKHROLI</a>
        <nav>
            <a asp-page="/Customers/Index">Customers</a>
            <a asp-page="/Transactions/Deposit">Deposit</a>
            <a asp-page="/Transactions/Withdraw">Withdraw</a>
            <a asp-page="/Transactions/Interest">Interest</a>
            <a asp-page="/CloseAccount">Close Account</a>
            <a asp-page="/Settings">Settings</a>
            <a asp-page="/Reports/Daily">Reports</a>
        </nav>
    </header>
    <main class="shell">
        @if (TempData["Message"] is string message)
        {
            <div class="alert">@message</div>
        }
        @RenderBody()
    </main>
</body>
</html>
